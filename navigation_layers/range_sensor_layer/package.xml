<?xml version="1.0"?>
<package format="3">
  <name>range_sensor_layer</name>
  <version>0.5.0</version>
  <description>Navigation Layer for Range sensors like sonar and IR</description>

  <maintainer email="davidvlu@gmail.com">David V. Lu!!</maintainer>
  <author>David!!</author>
  <license>BSD</license>

  <url type="website">http://wiki.ros.org/range_sensor_layer</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>angles</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>

    <!-- For Nav2 costmap plugins, this export tag is typically nav2_costmap_2d -->
    <nav2_costmap_2d plugin="${prefix}/costmap_plugins.xml"/>
  </export>
</package>

