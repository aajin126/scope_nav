<launch>
  <arg name="gui" default="true" doc="Bring up the Gazebo graphical interface"/>
  <arg name="model_file"   default="$(find scope_nav)/src/model/predocc_diff/ldm2.0/model.pth"/>
  <arg name="rviz" default="true"/> 
  <arg name="debug_save" value="true"/>

  <!-- eng_hall -->
  <!-- <arg name="scene_file" default="$(find pedsim_simulator)/scenarios/eng_hall.xml"/>  
  <arg name="world_name" default="$(find pedsim_gazebo_plugin)/worlds/eng_hall.world"/>
  <arg name="map_file" default="$(find robot_gazebo)/maps/gazebo_eng_lobby/gazebo_eng_lobby.yaml"/>
  <arg name="pose_initial_x" default="13.5"/> 
  <arg name="pose_initial_y" default="21.0"/>
  <arg name="pose_initial_theta" default="0.0"/>
  <arg name="initial_pose_x" default="10.5"/>
  <arg name="initial_pose_y" default="21.0"/>
  <arg name="initial_pose_a" default="0.13"/> -->

  <!-- xcorridor -->
  <!--arg name="world_file" default="xcorridor" />
  <arg name="scene_file" default="$(find sim_arena)/worlds/$(arg world_file)/scenarios/default.xml"/>
  <arg name="world_name" default="$(find sim_arena)/worlds/$(arg world_file)/worlds/$(arg world_file).world"/>
  <arg name="map_file" default="$(find sim_arena)/worlds/$(arg world_file)/map/map.yaml" />
  <arg name="pose_initial_x" default="0.0"/> 
  <arg name="pose_initial_y" default="4.0"/>
  <arg name="pose_initial_theta" default="-1.57"/>
  <arg name="initial_pose_x" default="0.0"/>
  <arg name="initial_pose_y" default="4.0"/>
  <arg name="initial_pose_a" default="-1.57"/-->

  <!-- freiburg -->
  <!-- <arg name="scene_file" default="$(find pedsim_simulator)/scenarios/freiburg.xml"/>  
  <arg name="world_name" default="$(find pedsim_gazebo_plugin)/worlds/freiburg.world"/>
  <arg name="map_file" default="$(find robot_gazebo)/maps/gazebo_freiburg/gazebo_freiburg.yaml"/>
  <arg name="pose_initial_x" default="10.0"/> 
  <arg name="pose_initial_y" default="23.0"/>
  <arg name="pose_initial_theta" default="-1.57"/>
  <arg name="initial_pose_x" default="7.0"/>
  <arg name="initial_pose_y" default="6.0"/>
  <arg name="initial_pose_a" default="-1.57"/> -->

  <!-- experiment_room_2 -->
  <arg name="world_file" default="experiment_room_2" />
  <arg name="scene_file" default="$(find sim_arena)/worlds/$(arg world_file)/scenarios/default.xml"/>  
  <arg name="world_name" default="$(find sim_arena)/worlds/$(arg world_file)/worlds/$(arg world_file).world"/>
  <arg name="map_file" default="$(find sim_arena)/worlds/$(arg world_file)/map/map.yaml"/>
  <arg name="pose_initial_x" default="-13.0"/> 
  <arg name="pose_initial_y" default="0.0"/>
  <arg name="pose_initial_theta" default="0.0"/>
  <arg name="initial_pose_x" default="-13.0"/>
  <arg name="initial_pose_y" default="0.0"/>
  <arg name="initial_pose_a" default="0.0"/>

  <!-- Pedsim Gazebo -->
  <include file="$(find pedsim_simulator)/launch/robot.launch">
    <arg name="scene_file" value="$(arg scene_file)"/>
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="pose_initial_x" value="$(arg pose_initial_x)"/> 
    <arg name="pose_initial_y" value="$(arg pose_initial_y)"/>
    <arg name="pose_initial_theta" value="$(arg pose_initial_theta)"/>
  </include>

  <!-- AMCL -->
  <!-- <include file="$(find scope_nav)/launch/amcl_demo.launch">
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
    <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
    <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
  </include> -->

  <!-- SLAM -->
  <!--node pkg="slam_toolbox" type="lifelong_slam_toolbox_node" name="slam_toolbox" output="screen">
      <rosparam command="load" file="$(find slam_toolbox)/config/mapper_params_lifelong.yaml" />
  </node-->

  <!-- Move base -->
  <include file="$(find scope_nav)/launch/includes/move_base.launch.xml"/>

  <!-- Goal visualization -->
  <node pkg="scope_nav" name="goal_visualize" type="goal_visualize.py" output="screen" />

  <!-- SCOPE Costmap Publisher -->
  <include file="$(find scope_nav)/launch/scope_costmap_pub.launch">
    <arg name="model_file" value="$(arg model_file)"/>
  </include>

  <!-- Guidance Planner -->
  <!-- <include file="$(find guidance_planner)/launch/guidance_planner.launch"/> -->

  <!-- Pedestrian Publisher -->
  <node name="track_ped_pub" pkg="scope_nav" type="track_ped_pub.py" output="screen"/>

  <!-- Goal visualization -->
  <node pkg="scope_nav" name="scope_goal_visualize" type="goal_visualize.py" output="screen" />

  <!-- Rviz -->
  <include file="$(find scope_nav)/launch/view_navigation.launch" if="$(arg rviz)"/>

</launch>
